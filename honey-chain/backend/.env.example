# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/honeychain

# === JWT ===
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === SERVER ===
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# === BLOCKCHAIN ===
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=your_hardhat_test_private_key_here
SMART_CONTRACT_ADDRESS=

# === AI SERVICE ===
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=

# === FILE STORAGE ===
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# For S3-compatible:
# STORAGE_TYPE=s3
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_BUCKET=honeychain-uploads
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=ap-south-1

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
IOT_RATE_LIMIT_MAX=1000

# === LOGGING ===
LOG_LEVEL=info
